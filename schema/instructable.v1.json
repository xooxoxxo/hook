{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relay instructable v1",
  "description": "An owner ask as exact steps. Relay's validator (and any compatible mailbox) is the source of truth: it also rejects secret-like values (sk-ant-, sk-..., xox[abp]-, ghp_, github_pat_, PEM private keys, AKIA...), hidden characters and documents over 32768 bytes, which JSON Schema cannot express.",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "title", "steps"],
  "properties": {
    "v": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "why": { "type": "string", "maxLength": 300 },
    "urgency": { "enum": ["now", "today", "whenever"], "default": "today" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/step" }
    },
    "verify": { "$ref": "#/$defs/step" },
    "reply": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "choices"],
      "properties": {
        "prompt": { "type": "string", "maxLength": 300 },
        "choices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 60 }
        }
      }
    },
    "links": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "maxLength": 60 },
          "url": { "$ref": "#/$defs/httpUrl" }
        }
      }
    },
    "from": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "session": { "type": "string" },
        "host": { "type": "string" },
        "cwd": { "type": "string" }
      }
    }
  },
  "$defs": {
    "httpUrl": { "type": "string", "pattern": "^https?://" },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["do"],
      "properties": {
        "do": { "type": "string", "minLength": 1, "maxLength": 300 },
        "where": { "type": "string", "maxLength": 60 },
        "code": { "type": "string", "maxLength": 4000 },
        "lang": { "type": "string", "maxLength": 20 },
        "expect": { "type": "string", "maxLength": 300 },
        "url": { "$ref": "#/$defs/httpUrl" }
      }
    }
  }
}
