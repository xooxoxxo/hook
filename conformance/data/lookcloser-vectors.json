      "new": {
        "v": 1,
        "title": "Rotate the staging deploy key",
        "steps": [
          {"do": "Install it", "id": "s1", "code": "sudo make install"},
          {"do": "Rotate the key", "id": "s2"}
        ]
      },
      "flags": []
    },
    {
      "name": "look-pattern-already-in-old",
      "note": "a changed code text is flagged again for a pattern its old value held",
