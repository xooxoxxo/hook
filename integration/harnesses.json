[
  {
    "id": "claude-code",
    "name": "Claude Code",
    "home": {"default": "~/.claude"},
    "detect": {"bins": ["claude"], "paths": ["~/.claude"], "apps": [], "probe": null},
    "pieces": {
      "mcp": [
        {
          "method": "cli",
          "requires": "claude",
          "add": [
            "claude",
            "mcp",
            "add-json",
            "--scope",
            "user",
            "relay",
            {"json": {"type": "stdio", "command": "{{python}}", "args": ["{{mcp_server}}"]}}
          ],
          "remove": ["claude", "mcp", "remove", "relay", "--scope", "user"],
          "writes": {"path": "~/.claude.json", "format": "json", "key": ["mcpServers", "relay"]},
          "verified": "pending",
          "note": "A user-scope server, not the plugin's: plugin servers get renamed tools."
        }
      ],
      "skill": [{"method": "plugin", "verified": "pending"}],
      "instructions": [
        {
          "method": "file",
          "path": "{{harness_home}}/rules/hook.md",
          "source": "instructions/hook.md",
          "verified": "pending"
        }
      ],
      "replies": [{"method": "plugin", "verified": "pending"}]
    },
    "plugin": {
      "method": "cli",
      "render": "plugins/claude",
      "dest": "{{plugins}}/claude",
      "add": [
        ["claude", "plugin", "marketplace", "add", "{{plugins}}/claude"],
        ["claude", "plugin", "install", "hook@hook", "--scope", "user"]
      ],
      "update": [["claude", "plugin", "marketplace", "update", "hook"]],
      "remove": [
        ["claude", "plugin", "uninstall", "hook@hook", "--scope", "user"],
        ["claude", "plugin", "marketplace", "remove", "hook"]
      ],
      "verified": "pending"
    },
    "owner_steps": [],
    "smoke": [
      {"argv": ["claude", "mcp", "get", "relay"]},
      {"argv": ["claude", "plugin", "list"], "expect": "hook@hook"}
    ],
    "sources": [
      "https://code.claude.com/docs/en/memory",
      "https://code.claude.com/docs/en/mcp",
      "https://code.claude.com/docs/en/hooks",
      "https://code.claude.com/docs/en/plugins-reference",
      "https://code.claude.com/docs/en/plugins/loading",
      "https://code.claude.com/docs/en/plugins/cli-reference"
    ],
    "checked": "2026-11-03",
    "verified": "pending"
  },
  {
    "id": "codex",
    "name": "Codex",
    "home": {"env": "CODEX_HOME", "default": "~/.codex"},
    "detect": {"bins": ["codex"], "paths": ["{{harness_home}}"], "apps": [], "probe": null},
    "pieces": {
      "mcp": [
        {
          "method": "cli",
          "requires": "codex",
          "add": ["codex", "mcp", "add", "relay", "--", "{{python}}", "{{mcp_server}}"],
          "remove": ["codex", "mcp", "remove", "relay"],
          "writes": {"path": "{{harness_home}}/config.toml", "format": "toml", "key": ["mcp_servers", "relay"]},
          "verified": "pending"
        },
        {
          "method": "key",
          "path": "{{harness_home}}/config.toml",
          "format": "toml",
          "key": ["mcp_servers", "relay"],
          "value": {"command": "{{python}}", "args": ["{{mcp_server}}"]},
          "verified": "pending"
        }
      ],
      "skill": [
        {
          "method": "copy",
          "path": "~/.agents/skills/instructables",
          "source": "skills/instructables",
          "verified": "pending"
        }
      ],
      "instructions": [
        {
          "method": "block",
          "path": "{{harness_home}}/AGENTS.md",
          "prefer": ["{{harness_home}}/AGENTS.override.md"],
          "content": "full",
          "verified": "pending"
        }
      ],
      "replies": [
        {
          "method": "key",
          "path": "{{harness_home}}/hooks.json",
          "format": "json",
          "key": ["hooks", "UserPromptSubmit"],
          "op": "append",
          "match": "hook replies",
          "value": {"hooks": [{"type": "command", "command": "{{replies:claude}}", "timeout": 5}]},
          "verified": "pending"
        }
      ]
    },
    "plugin": null,
    "owner_steps": [
      {
        "id": "codex-trust",
        "when": "after:replies",
        "title": "Trust Hook's prompt hook in Codex",
        "why": "Codex runs a new hook only after you trust it once; the command stays the same across updates.",
        "steps": [
          {"do": "Start Codex in Terminal", "code": "codex", "lang": "bash", "where": "Mac terminal"},
          {"do": "Open the list of hooks", "code": "/hooks", "lang": "text", "where": "Codex"},
          {"do": "Select the hook that runs relay hook replies, and choose Trust", "where": "Codex"}
        ],
        "verify": {"do": "Answer any Hook ask, then send Codex a prompt: it shows a Hook line with your answer"}
      }
    ],
    "smoke": [{"argv": ["codex", "mcp", "list"], "expect": "relay"}],
    "sources": [
      "https://learn.chatgpt.com/docs/agent-configuration/agents-md",
      "https://developers.openai.com/codex/skills",
      "https://learn.chatgpt.com/docs/config-file/config-reference",
      "https://learn.chatgpt.com/docs/hooks"
    ],
    "checked": "2026-11-03",
    "verified": "pending"
  },
