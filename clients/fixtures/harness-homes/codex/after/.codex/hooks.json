{
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "~/.claude/my-tools/ask.py status"}]}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/HOME/.local/share/hook/current/bin/relay' hook replies --format claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
