// Zed settings
//
// For information on how to configure Zed, see the Zed documentation.
{
  "theme": "One Dark",
  "buffer_font_size": 14,
  "agent": {
    "default_model": {"provider": "anthropic", "model": "claude-sonnet"},
    "always_allow_tool_actions": false,
    "profiles": {"write": {"name": "Write", "tools": {"terminal": true}}}
  },
  "context_servers": {
    "other": {
      "command": "npx",
      "args": ["-y", "other-mcp"],
      "env": {"OTHER_KEY": "sk-test-not-a-secret"} // a token
    }
  }
}
