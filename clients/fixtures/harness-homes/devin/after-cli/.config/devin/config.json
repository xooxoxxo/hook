{
  "read_config_from": {"claude": true},
  "hooks": {
    "PreToolUse": [
      {"matcher": "exec", "hooks": [{"type": "command", "command": "~/.claude/my-tools/check.sh"}]}
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "'/HOME/.local/share/hook/current/bin/relay' hook replies --format claude",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
