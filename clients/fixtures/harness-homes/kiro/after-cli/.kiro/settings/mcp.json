{
  "mcpServers": {
    "other": {
      "command": "npx",
      "args": ["-y", "other-mcp"],
      "env": {"OTHER_KEY": "sk-test-not-a-secret"}
    },
    "relay": {
      "fake": "kiro-cli",
      "args": [
        "--name",
